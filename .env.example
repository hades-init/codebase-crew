# Copy to `.env` and fill in config values.
# `.env` is gitignored — never commit real secrets.

# Environment = ["local", "staging", "production"]
ENVIRONMENT=local

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token — a fine-grained PAT scoped to ONLY the repo.
# Needs: issues (read/write), contents (read/write), pull requests (read/write).
GITHUB_TOKEN=github_pat_...

# The repo the crew operates on, as "owner/name".
GITHUB_REPO=your-username/your-repo

# Langsmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...                       # from smith.langchain.com → Settings
LANGSMITH_PROJECT=codebase-crew                  
LANGSMITH_ENDPOINT=<api-endpoint>
